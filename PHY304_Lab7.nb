Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", "9.81"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", "=", " ", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]0", "=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"g", "/", "L"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]", "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "0", "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"\[Omega]0", " ", "t"}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "2"}], "}"}], ",", " ", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<t (s)\>\"", ",", "\"\<y (rad)\>\""}], "}"}]}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"s", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]", "''"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"\[Omega]0", "^", "2"}], ")"}]}], "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Phi]", "[", "t", "]"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "0", "]"}], "==", 
         RowBox[{"30", "*", "Degree"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",",
       "\[Phi]", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"\[Phi]", "[", "t", "]"}], "/.", " ", "s"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t (s)\>\"", ",", "\"\<\[Phi] (rad)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Orange", ",", "Thick"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.001770265550227*^9, 4.00177026945408*^9}, {
