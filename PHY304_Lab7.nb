 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "penfunc", ",", "anFunc", ",", "iseMetric", ",", "angle", ",", "\[Phi]"}], 
   "]"}], "\[IndentingNewLine]"}]], "Input",
