   4.0017710726533337`*^9, 4.001771107801762*^9}, {4.0017740610985947`*^9, 
   4.001774070370119*^9}, {4.001774451503388*^9, 4.0017745119293613`*^9}, {
   4.001774743378812*^9, 4.001774757886426*^9}, {4.001774790207204*^9, 
   4.001774797927947*^9}, {4.001775684684411*^9, 4.001775800315632*^9}, {
   4.0032600878261633`*^9, 4.003260119933374*^9}, {4.0032601676633244`*^9, 
