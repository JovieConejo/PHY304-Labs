Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"penfunc", "[", "\[Phi]0_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Phi]", "''"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"\[Omega]0", "^", "2"}], ")"}]}], "*", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Phi]", "[", "t", "]"}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"\[Phi]", "[", "0", "]"}], "==", 
           RowBox[{"\[Phi]0", "*", "Degree"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",",
         "\[Phi]", ",", 
        RowBox[{"{", 
